{
  "name": "jknet",
  "private": true,
  "version": "0.11.2",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/i18n-check.mjs",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:seed": "node scripts/i18n-seed.mjs",
    "test:unit": "node --test \"src/**/*.test.mjs\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts && node web/scripts/build-sw.mjs && node web/scripts/write-version.mjs && node web/scripts/check-bundle.mjs",
    "web:build:e2e": "vite build --config web/vite.config.ts --mode e2e --outDir e2e/dist && node web/scripts/build-sw.mjs --out web/e2e/dist && node web/scripts/write-version.mjs --out web/e2e/dist",
    "web:preview": "vite preview --config web/vite.config.ts",
    "web:typecheck": "tsc -p web/tsconfig.json --noEmit && tsc -p web/src/sw/tsconfig.json --noEmit && tsc -p web/e2e/tsconfig.json --noEmit",
    "web:test": "node --test \"web/src/**/*.test.mjs\"",
    "web:test:online": "node --test \"web/src/**/*.online-test.mjs\"",
    "web:e2e": "npm run web:build:e2e && playwright test -c web/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-log": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "emojibase-data": "^17.0.0",
    "i18next": "^25.10.10",
    "lucide-react": "^1.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.6.6",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "~24.19.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.2",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
