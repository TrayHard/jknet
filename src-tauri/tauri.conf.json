{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JKNet",
  "mainBinaryName": "JKNet",
  "version": "0.4.0",
  "identifier": "org.jknet.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JKNet",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0B0E14",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/cache/levelshots/**",
          "$APPLOCALDATA/cache/skins/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "JKNet",
    "category": "Game",
    "shortDescription": "Launcher for Jedi Academy and Jedi Outcast",
    "longDescription": "JKNet manages Jedi Academy and Jedi Outcast clients, installs community engines and JKHub mods, previews game assets, browses servers and connects friends.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/jkhub/"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German",
          "Spanish",
          "French",
          "Hungarian",
          "Polish",
          "Russian",
          "Ukrainian"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "JKNet"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxMUUwMzQxOTI5MERERUUKUldUdTNaQ1NRUU1lWWZSdjRTcnBrenBHZTg2RC8zU3JiUWVxRUxSNDNjajNaYnFHYlpQYnBrQkEK",
      "endpoints": [
        "https://github.com/TrayHard/jknet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
