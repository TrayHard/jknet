{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JKNet",
  "mainBinaryName": "JKNet",
  "version": "0.1.0",
  "identifier": "org.jknet.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JKNet",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0B0E14",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "JKNet",
    "shortDescription": "Launcher for Jedi Academy multiplayer",
    "longDescription": "JKNet manages Jedi Academy multiplayer clients, pk3 library and servers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
