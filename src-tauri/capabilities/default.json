{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the main window: custom title bar, file and folder pickers, core events including drag and drop, logging, saved window geometry, external links, opening %LOCALAPPDATA%\\org.jknet.launcher in the file manager, stepping aside while the game runs, and updating the launcher itself.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "log:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPLOCALDATA" }]
    },
    "window-state:default",
    "updater:default",
    "process:allow-restart"
  ]
}
