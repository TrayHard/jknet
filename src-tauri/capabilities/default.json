{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the main window: custom title bar, file and folder pickers, core events including drag and drop, logging, saved window geometry, external links and opening %LOCALAPPDATA%\\JKNet in the file manager.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "log:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$LOCALDATA/JKNet" }]
    },
    "window-state:default"
  ]
}
